# Copy this file to .env and adjust as needed
DATABASE_URL=sqlite:///./data/shopsense.db
APP_NAME=ShopSense
APP_ENV=development
DEFAULT_COMMISSION_RATE=0.10
LOW_STOCK_THRESHOLD_DEFAULT=10

# --- Milestone 3: Advanced Analytics, APIs & Reporting ---
# For Docker/production, point at the postgres service, e.g.:
# DATABASE_URL=postgresql+psycopg2://shopsense:shopsense@db:5432/shopsense
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=shopsense-analytics
ENABLE_SCHEDULER=false
ETL_CRON_HOUR=2
ETL_CRON_MINUTE=0
MODEL_RETRAIN_CRON_DAY_OF_WEEK=sun
REPORTS_EXPORT_DIR=reports/exports

